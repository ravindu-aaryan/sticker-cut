{
  "name": "sticker-cut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn photos into print-ready sticker sheets with multiple cutting styles, AI background removal and upscaling.",
  "scripts": {
    "models": "node scripts/copy-models.mjs",
    "predev": "npm run models",
    "dev": "vite",
    "prebuild": "npm run models",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tensorflow/tfjs": "~4.11.0",
    "@upscalerjs/esrgan-slim": "^1.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
